{
  "version": 2,
  "builds": [
    {
      "src": "backend/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(generate|save-timetable|check-clash|send-otp|verify-otp)",
      "destination": "backend/app.py"
    },
    {
      "source": "/static/(.*)",
      "destination": "frontend/static/$1"
    },
    {
      "source": "/(favicon.ico|logo192.png|logo512.png|manifest.json|robots.txt|logo.svg)",
      "destination": "frontend/$1"
    },
    {
      "source": "/(.*)",
      "destination": "frontend/index.html"
    }
  ]
}
